# --- Server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated origins allowed by CORS (the iOS app doesn't need CORS; this is for web admin tools).
CORS_ORIGINS=http://localhost:5173
# Per-IP rate limiting (disable only for tests/load testing)
RATE_LIMIT_ENABLED=true

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://arranged:arranged@localhost:5432/arranged

# --- Auth ---
# 32+ random bytes, base64. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
# dev | twilio
OTP_PROVIDER=dev
# In dev mode every phone accepts this code (and the real code is logged).
OTP_DEV_CODE=000000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Payments ---
# fake | stripe
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price id for the monthly membership (optional)
STRIPE_MEMBERSHIP_PRICE_ID=

# --- Push notifications ---
# log | apns
PUSH_PROVIDER=log
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.arranged.app
# Contents of the .p8 key, with newlines escaped as \n
APNS_PRIVATE_KEY=
APNS_USE_SANDBOX=true

# --- Admin ---
# Bearer token accepted on /admin routes (in addition to users with role=admin)
ADMIN_API_TOKEN=dev-admin-token

# --- Jobs ---
# Run the in-process scheduler (set to false when running jobs from an external cron)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
